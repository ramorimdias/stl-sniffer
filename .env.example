APP_NAME=STL Sniffer
APP_ENV=production
STL_SNIFFER_HOSTNAME=stlsniffer.example.com
DOCKER_NETWORK=aio_network

POSTGRES_DB=stl_sniffer
POSTGRES_USER=stl_sniffer
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://stl_sniffer:replace-me@postgres:5432/stl_sniffer

REDIS_URL=redis://redis:6379/0

MEILI_MASTER_KEY=replace-me
MEILI_URL=http://meilisearch:7700
MEILI_INDEX=torrents

MAX_TORRENT_BYTES=5242880
MAGNET_RESOLVE_TIMEOUT_SECONDS=75
SUBMISSION_RATE_LIMIT_PER_HOUR=30
MODEL_EXTENSIONS=.stl,.3mf,.obj,.step,.stp,.iges,.igs,.scad

SOURCE_FEEDS=
SOURCE_POLL_INTERVAL_SECONDS=900
SOURCE_ENABLE_INTERNET_ARCHIVE=true
SOURCE_ENABLE_ACADEMIC_TORRENTS=false
SOURCE_INTERNET_ARCHIVE_QUERY=(title:(stl OR 3mf OR "3d model" OR "3d print") OR description:(stl OR 3mf OR "3d model" OR "3d print"))
SOURCE_INTERNET_ARCHIVE_ROWS=50
SOURCE_ACADEMIC_TORRENTS_LIMIT=50

TORRUST_TRACKER_ADMIN_TOKEN=replace-me
TRACKER_HTTP_PORT=7070
TRACKER_UDP_PORT=6969
